#!/bin/sh
# The single entry point. CI calls these exact subcommands, so there is no
# orchestration that exists only in a workflow YAML.
#
#   ./run up            bring the SUT up, wait for it, reset its data
#   ./run down          stop the SUT
#   ./run test          run the whole suite
#   ./run report        render the Allure report from the last run and open it
#   ./run logs          tail the application's container logs
#   ./run status        where things are and whether they answer
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
COMPOSE="$HERE/docker/docker-compose.sut.yml"

# The application under test comes from the pinned compose file in THIS
# repository, so a developer and CI bring up the same digests. Cloning the
# application and using its own compose files means the version under test is
# whatever that clone is on, which makes "it passes locally" unfalsifiable.
#
# TOOLSHOP_SUT_DIR overrides it with a clone, for the case of working on the
# application itself. Nothing in CI sets it.
sut() {
    if [ -n "${TOOLSHOP_SUT_DIR:-}" ]; then
        if [ ! -d "$TOOLSHOP_SUT_DIR" ]; then
            printf 'TOOLSHOP_SUT_DIR is set but is not a directory: %s\n' "$TOOLSHOP_SUT_DIR" >&2
            exit 1
        fi
        ( cd "$TOOLSHOP_SUT_DIR" && docker compose "$@" )
    else
        docker compose -f "$COMPOSE" "$@"
    fi
}

case "${1:-help}" in
  up)
    sut up -d
    # `docker compose up -d` returns when containers start, not when migrations
    # finish, so wait before touching the API.
    "$HERE/scripts/wait-for-sut.sh"

    # The application's own reset hook, not `artisan migrate:fresh --seed`.
    #
    # Seeding alone is not enough and the failure is nasty: the read endpoints
    # are served from a server-side cache, so after a reseed /products keeps
    # answering with the previous run's product IDs while cart validation - which
    # goes to the database - rejects them as invalid. Every checkout test then
    # fails claiming the product does not exist, and /products disagrees.
    #
    # POST /refresh runs migrate:fresh --seed, removes generated invoices, and
    # flushes the cache. The application's own source comments say why.
    #
    # This wipes all data. It runs here, once, and never between tests.
    printf 'Resetting application data (migrate, seed, cache flush)...\n'
    curl -fsS -m 180 -X POST "${TOOLSHOP_API_BASE_URL:-http://localhost:8091}/refresh" \
        -H 'Accept: application/json' >/dev/null

    "$HERE/scripts/wait-for-sut.sh" >/dev/null
    printf '\nSUT ready.  UI http://localhost:4200  API http://localhost:8091  mail http://localhost:1080\n'
    ;;

  down)
    sut down
    ;;

  test)
    # Fail with one clear message rather than N test timeouts when the SUT is down.
    "$HERE/scripts/wait-for-sut.sh" >/dev/null
    shift
    "$HERE/gradlew" test "$@"
    ;;

  report)
    # Allure 3, from every module's results at once.
    #
    # The renderer is a Node CLI, not a Gradle plugin: the Allure Gradle plugin
    # adds dependencies and an AspectJ javaagent to the build, and the only thing
    # needed here is a report generator. npx pins the version on the invocation.
    #
    # Results are written under each module's build/ (the default resolves
    # against the module directory, which puts them outside build/ where `clean`
    # never finds them - the conventions plugin redirects them).
    results=$(find "$HERE" -type d -name allure-results -path '*/build/*' 2>/dev/null)
    if [ -z "$results" ]; then
        printf 'No results to report. Run the suite first:\n  ./run test\n' >&2
        exit 1
    fi

    printf 'Generating from:\n'
    printf '  %s\n' $results
    # shellcheck disable=SC2086
    npx --yes allure@3 generate $results \
        -o "$HERE/build/allure-report" --name 'Toolshop automation'
    printf '\nReport: %s/build/allure-report/index.html\n' "$HERE"
    # Serve it only for a human. In CI stdout is not a terminal and `open`
    # would block the job forever.
    if [ -t 1 ]; then
        npx --yes allure@3 open "$HERE/build/allure-report"
    fi
    ;;

  logs)
    # What the application says when a test cannot explain itself. CI runs this
    # on failure; it is the same command locally.
    shift 2>/dev/null || true
    sut logs --no-color --tail "${TOOLSHOP_LOG_LINES:-200}" "$@"
    ;;

  status)
    printf '%-12s %-34s %s\n' SERVICE URL STATE
    for entry in \
        "UI|http://localhost:4200" \
        "API|http://localhost:8091/status" \
        "mail|http://localhost:1080" \
        "phpmyadmin|http://localhost:8000/index.php"
    do
        name=${entry%%|*}; url=${entry#*|}
        code=$(curl -sS -o /dev/null -m 5 -w '%{http_code}' "$url" 2>/dev/null || echo '---')
        printf '%-12s %-34s %s\n' "$name" "$url" "$code"
    done
    ;;

  *)
    printf 'usage: ./run up | down | test [gradle args] | report | logs | status\n' >&2
    exit 2
    ;;
esac
